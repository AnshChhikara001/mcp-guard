# Copy to .env and adjust. .env is gitignored; never commit real values.
# Docker Compose reads this file for the local Postgres; the defaults below match docker-compose.yml.

# Local Postgres (docker compose up -d --wait postgres)
POSTGRES_USER=mcpguard
POSTGRES_PASSWORD=mcpguard
POSTGRES_DB=mcpguard
POSTGRES_PORT=5432

# Connection string the services, tests and `make reset-bank` use. Locally it points at the container above;
# in production it is the Neon connection string. Keep it in sync with the values above.
DATABASE_URL=postgresql://mcpguard:mcpguard@localhost:5432/mcpguard

# Where the Gateway listens (make gateway). Agents connect to http://GATEWAY_HOST:GATEWAY_PORT/mcp.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000

# Where the Agent finds the Gateway (make chat).
GATEWAY_URL=http://127.0.0.1:8000/mcp

# The Agent's model (make chat), as provider:model. Unset: the scripted fake model, no key needed.
# MODEL=gemini:gemini-3.5-flash
# GEMINI_API_KEY=
# (A GOOGLE_API_KEY in the environment takes precedence over GEMINI_API_KEY.)
# MODEL=openai:gpt-5-mini
# OPENAI_API_KEY=
# Further providers, from a Python file outside the repository that defines ADAPTERS.
# MODEL_ADAPTERS_FILE=/path/to/my_adapters.py
# How long one request to the model may take before it is given up (default 60).
# MODEL_TIMEOUT_SECONDS=60

# Tracing (OpenTelemetry). Set the endpoint to turn it on; leave it unset to keep tracing off.
# We send traces to Langfuse Cloud: https://cloud.langfuse.com/api/public/otel (EU)
# or https://us.cloud.langfuse.com/api/public/otel (US). The header carries the project's keys,
# from Langfuse's Project settings → API keys:  echo -n "pk-lf-…:sk-lf-…" | base64
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 of public_key:secret_key>,x-langfuse-ingestion-version=4
