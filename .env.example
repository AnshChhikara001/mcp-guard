# Copy to .env and adjust. .env is gitignored; never commit real values.
# Docker Compose reads this file for the local Postgres; the defaults below match docker-compose.yml.

# Local Postgres (docker compose up -d --wait postgres)
POSTGRES_USER=mcpguard
POSTGRES_PASSWORD=mcpguard
POSTGRES_DB=mcpguard
POSTGRES_PORT=5432

# Connection string the services, tests and `make reset-bank` use. Locally it points at the container above;
# in production it is the Neon connection string. Keep it in sync with the values above.
DATABASE_URL=postgresql://mcpguard:mcpguard@localhost:5432/mcpguard

# Where the Gateway listens (make gateway). Agents connect to http://GATEWAY_HOST:GATEWAY_PORT/mcp.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
